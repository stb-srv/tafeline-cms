# Tafeline CMS Environment Configuration
# Kopiere diese Datei nach .env und passe die Werte an.
# Bei Nutzung von setup.sh wird .env automatisch erstellt.

# ============================================================
# SERVER
# ============================================================
PORT=5000

# Hostname dieser Instanz – wird für den License domain-Check verwendet.
# Muss exakt dem Domain-Feld in der Lizenz entsprechen.
# Auf localhost wird der Check automatisch übersprungen.
HOST=meinrestaurant.de

# JWT-Secret für Admin-Sessions – wird automatisch generiert.
# NICHT manuell ändern, wenn Benutzer eingeloggt sind.
ADMIN_SECRET=change-this-to-a-long-random-string

# Lizenzserver und Public Key sind fest im Code hinterlegt und in Produktion NICHT konfigurierbar.
# Nur bei NODE_ENV=development wirken diese Overrides (lokaler Lizenzserver):
# LICENSE_SERVER_URL=http://localhost:4000
# LICENSE_PUBLIC_KEY=

# Auf true setzen für Entwicklungsmodus (lockert einige Prüfungen)
DEV_MODE=false

# ============================================================
# LOGGING
# ============================================================
# Log-Level: trace | debug | info | warn | error | fatal
# Produktiv: info (Standard)
# Entwicklung: debug (via DEV_MODE=true automatisch gesetzt)
LOG_LEVEL=info

# ============================================================
# DATENBANK
# ============================================================
# Tafeline nutzt SQLite (server/database.sqlite). Optional anderer Pfad:
# SQLITE_PATH=./server/database.sqlite

# ============================================================
# CORS – Erlaubte Domains
# ============================================================
# Alle Domains die auf diesen Server zugreifen, kommagetrennt.
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# ============================================================
# SMTP – E-Mail-Konfiguration (für Reservierungsbestätigungen)
# ============================================================
# Kann alternativ komplett über das CMS unter Einstellungen > E-Mail
# eingerichtet werden – dann sind diese Werte hier nicht nötig.
#
# Gängige Provider:
#   IONOS / 1&1:  smtp.ionos.de         Port 465  SMTP_SECURE=true
#   Strato:       smtp.strato.de        Port 465  SMTP_SECURE=true
#   GMX:          mail.gmx.net          Port 465  SMTP_SECURE=true
#   Gmail:        smtp.gmail.com        Port 587  SMTP_SECURE=false
#   Office 365:   smtp.office365.com    Port 587  SMTP_SECURE=false

SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@meinrestaurant.de
SMTP_PASS=dein-smtp-passwort
SMTP_FROM="Mein Restaurant" <info@meinrestaurant.de>

# WARNUNG: Nur auf true setzen wenn ein interner SMTP-Server mit
# selbstsigniertem Zertifikat genutzt wird. Deaktiviert die TLS-
# Zertifikatsprüfung und macht die Verbindung anfällig für
# Man-in-the-Middle-Angriffe. Für alle öffentlichen SMTP-Provider
# (IONOS, Strato, GMX, Gmail, Office 365 etc.) auf false/unset lassen.
# SMTP_ALLOW_INSECURE_TLS=false
